# Copy to backend/.env and adjust. Values below are the local-development defaults.

# --- Required (settings raise on startup without these) ---
SECRET_KEY=change-me-to-a-long-random-string
OPERATOR_DASHBOARD_URL=http://127.0.0.1:3000
PUBLIC_SITE_URL=http://127.0.0.1:3001

# --- Core ---
DJANGO_ENV=local
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database ---
# Leave DATABASE_URL empty to fall back to SQLite at backend/db.sqlite3.
# Postgres example: postgres://user:password@127.0.0.1:5432/azizam
DATABASE_URL=sqlite:///db.sqlite3

# --- Browser clients ---
# The dashboard and the website call the API cross-origin, so both need listing.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Auth tokens ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Preview links ---
# Defaults to PUBLIC_SITE_URL / "preview_token" when unset. The query key must
# match NEXT_PUBLIC_PREVIEW_QUERY_KEY in Website/.env.local.
PUBLIC_SITE_PREVIEW_URL=http://127.0.0.1:3001
PUBLIC_SITE_PREVIEW_QUERY_KEY=preview_token

# --- Optional integrations (blank disables them) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
REDIS_URL=

# --- Media storage ---
# local keeps uploads in backend/media/.
MEDIA_BACKEND=local
STORAGE_BUCKET_NAME=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=

# --- Production only ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_LOG_LEVEL=INFO
